# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Models (large binary files — download separately)
models/*.gguf

# Runtime data (generated at runtime).
#
# NOTE the trailing /* rather than /. Git cannot re-include a path whose parent
# DIRECTORY is excluded, so the old `data/` pattern silently defeated every
# negation below it: already-tracked files were fine (tracked files bypass
# .gitignore), but any NEW file — including an augmentor YAML promoted by the
# self-improving pipeline — was ignored without a word. `data/*` excludes the
# contents instead of the directory, which lets the negations actually work.
data/*
# But keep augmentor examples and module definitions (checked into repo)
!data/augmentor_examples/
!data/knowledge/
!data/pattern_graph.yaml
# Capability catalogs are source, not runtime output — the broker is inert
# without them (see engine/capability_broker.py).
!data/capabilities/

# Tuned config (machine-specific)
tuned_config.json

# Secrets
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
.mypy_cache/
results/
parse_dumps/
__pycache__/
*.pyc

# Benchmark artifacts — written by benchmark_agentic.py / benchmark_*.py
# at the repo root. Useful as evidence inside an experiment branch but
# shouldn't bleed across branches or land in history. The JSONs from the
# existing archived run are in commit d8e19f3.
bench_*.json
bench[0-9]*.json
bench_*.log
bench_*.stderr.log
bench_*.stdout.log
bench_*_log.txt
download_*.log

# Diagnostic / probe scripts — _-prefixed at repo root by convention.
# Throwaway one-shots for verifying a pipeline; not unit tests, not
# part of the harness.
_probe_*.py
_smoke_*.py
